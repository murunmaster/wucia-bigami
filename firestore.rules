rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'sj060728@gmail.com';
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // 공지: 누구나 읽고, 주인장만 쓴다
    match /site/notices/items/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    // 명부: 누구나 읽고, 각자 자기 것만 쓴다(주인장은 모두)
    match /pcs/{uid} {
      allow read: if true;
      allow write: if isSelf(uid) || isOwner();
    }
    // 방명록: 같은 방식
    match /guestbook/{uid} {
      allow read: if true;
      allow write: if isSelf(uid) || isOwner();
    }
    // 오의: 자기 것과 주인장만
    match /pcog/{uid} {
      allow read, write: if isSelf(uid) || isOwner();
    }
    // 전투판 방: 누구나 본다. 로그인한 사람이 만들고(만든 사람이 GM), 참가한 사람만 고친다.
    // 참가는 자기 자신을 명단(mem)에 더하는 것만 된다. 없애는 것은 GM과 주인장만
    match /rooms/{id} {
      function isRoomGm() { return resource.data.gm == request.auth.uid; }
      function isMember() { return !('mem' in resource.data) || request.auth.uid in resource.data.mem; }
      function joining() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mem'])
          && request.resource.data.mem.hasAll(resource.data.mem)
          && request.resource.data.mem.size() == resource.data.mem.size() + 1
          && request.auth.uid in request.resource.data.mem;
      }
      allow read: if true;
      allow create: if signedIn() && request.resource.data.gm == request.auth.uid;
      allow update: if signedIn() && (isRoomGm() || isOwner() || isMember() || joining());
      allow delete: if signedIn() && (isRoomGm() || isOwner());
    }
    // GM 서고(gm으로 시작하는 저장소 전부): 주인장만
    match /{col}/{rest=**} {
      allow read, write: if isOwner() && col.matches('gm.*');
    }
  }
}
