rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'sj060728@gmail.com';
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // 공지: 누구나 읽고, 주인장만 쓴다
    match /site/notices/items/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    // 명부: 누구나 읽고, 각자 자기 것만 쓴다(주인장은 모두)
    match /pcs/{uid} {
      allow read: if true;
      allow write: if isSelf(uid) || isOwner();
    }
    // 방명록: 같은 방식
    match /guestbook/{uid} {
      allow read: if true;
      allow write: if isSelf(uid) || isOwner();
    }
    // 오의: 자기 것과 주인장만
    match /pcog/{uid} {
      allow read, write: if isSelf(uid) || isOwner();
    }
    // GM 서고(gm으로 시작하는 저장소 전부): 주인장만
    match /{col}/{rest=**} {
      allow read, write: if isOwner() && col.matches('gm.*');
    }
  }
}
